# Copier en .env pour docker-compose / production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DATABASE_URL=postgres://appsport:appsport@db:5432/appsport
SENTRY_DSN=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=App Sport <no-reply@example.com>
